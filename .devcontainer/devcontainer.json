{
  "name": "Retail Demand Forecasting",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "dashboard/app.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements-dev.txt && python -m pip install -e .",
  "postAttachCommand": "python -m streamlit run dashboard/app.py",
  "portsAttributes": {
    "8501": {
      "label": "Streamlit dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
